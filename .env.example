# Vite exposes these public values in browser bundles. Provider API keys stay on the backend.
VITE_CONVEX_URL=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Optional for production source map uploads during Vite builds.
# POSTHOG_CLI_API_KEY (personal key; keep in an untracked private env file)
# POSTHOG_CLI_PROJECT_ID=283153
# POSTHOG_CLI_HOST=https://eu.posthog.com

# Set these with `bunx convex env set NAME` (interactive value input).
# X_MD_API_KEY
# X_MD_API_KEY_FALLBACK (optional second key, tried when the first is refused or rate limited)
# X_MD_BASE_URL (https://mdfromx.com or https://x.pcstyle.dev)
# RAW_CAPTURE_URL (friend's durable raw-capture receiver)
# SEARCH_API_URL (friend's retrieval endpoint)
# SEARCH_SERVICE_TOKEN (read-only credential for SEARCH_API_URL)
# RAW_CAPTURE_TOKEN (ingestion-only credential for RAW_CAPTURE_URL)
# DATA_SERVICE_TOKEN (legacy shared fallback only; never the x.md key)
# FIRECRAWL_API_KEY
# OPENAI_API_KEY
# OPENAI_MODEL (default: gpt-5-mini)
# AGENTMAIL_API_KEY
# AGENTMAIL_INBOX_ID
# AGENTMAIL_WEBHOOK_SECRET
# POSTHOG_PROJECT_TOKEN (the project's public ingestion token)
# POSTHOG_HOST (https://eu.i.posthog.com for this project)
# SITE_URL
# JWT_PRIVATE_KEY and JWKS (see scripts/setup-auth.mjs)
