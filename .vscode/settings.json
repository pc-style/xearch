{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "dist": true,
    ".convex": true,
    ".local-captures": true,
    ".local-hosting": true,
    "coverage": true,
    ".vite": true,
    "search/target": true,
    "convex/_generated": true,
    "xearch-old": true
  }
}
