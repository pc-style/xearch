{
  "name": "xearch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --no-typescript --oxlint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "worker:production": "bun scripts/production-worker.ts",
    "env:sync": "node scripts/sync-env.mjs",
    "capture:setup": "node scripts/setup-capture.mjs",
    "capture": "node scripts/capture-server.mjs",
    "dev": "vite --host 0.0.0.0",
    "backend": "convex dev",
    "build": "tsc --noEmit && vite build && node scripts/check-public-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "bunx @convex-dev/static-hosting deploy",
    "deploy:prod": "CONVEX_DEPLOYMENT=prod:utmost-kudu-321 NODE_OPTIONS=--max-old-space-size=3072 bash scripts/with-posthog-build-env.sh bunx @convex-dev/static-hosting deploy --build-command 'bun run build'",
    "build:operator": "tsc --noEmit && VITE_XEARCH_OPERATOR=1 vite build --outDir dist-operator --emptyOutDir"
  },
  "dependencies": {
    "@agentmail/convex": "latest",
    "@convex-dev/auth": "latest",
    "@convex-dev/static-hosting": "latest",
    "@firecrawl/firecrawl-convex": "latest",
    "@posthog/convex": "^2.1.5",
    "@solidjs/web": "2.0.0-rc.9",
    "convex": "^1.45.0",
    "effect": "4.0.0-rc.112",
    "posthog-js": "^1.434.12",
    "solid-js": "2.0.0-rc.9",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.44.0",
    "@oxlint/plugins": "1.82.0",
    "@posthog/rollup-plugin": "^1.6.0",
    "@solidjs/vite-plugin": "3.0.0-next.44",
    "@types/node": "^26.0.0",
    "convex-test": "latest",
    "jsdom": "^30.1.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vitest": "latest"
  }
}
