[Unit]
Description=Xearch private semantic API (loopback 4330)
After=xearch-qdrant.service

[Service]
Type=simple
WorkingDirectory=%h/xearch-semantic/current/runtime
EnvironmentFile=%h/xearch-data/semantic/semantic.env
Environment=HF_HUB_OFFLINE=1 TOKENIZERS_PARALLELISM=false OMP_NUM_THREADS=1
ExecStart=%h/xearch-semantic/current/runtime/.venv/bin/python -m semantic.service serve
Restart=on-failure
RestartSec=5
UMask=0077
Nice=10
MemoryHigh=512M
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=append:%h/xearch-data/semantic/logs/api.log
StandardError=append:%h/xearch-data/semantic/logs/api.log

[Install]
WantedBy=default.target
